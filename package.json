{
  "name": "@gratise/i18n",
  "version": "0.1.0",
  "description": "React internationalization with SSR, ICU messages, and translation tooling",
  "homepage": "https://gratise.github.io/i18n/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gratise/i18n.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "require": "./dist/providers.cjs"
    }
  },
  "bin": {
    "gratise-i18n": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && rspack build -c rspack.config.mjs && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "dev": "rspack build -c rspack.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "intl-messageformat": "^10.7.18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
